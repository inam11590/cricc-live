# CricLive Environment Configuration Template
# For local development: copy this file to .env.local

# Application Info
NEXT_PUBLIC_APP_NAME="CricLive"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cricket Data Provider Selection
# Options:
#   - mock: Deterministic local development fixtures (default, no credentials required)
#   - partner_api: Production authenticated REST provider (requires CRICLIVE_PARTNER_API_KEY)
#   - scraper_bridge: External Python microservice (requires CRICLIVE_SCRAPER_SERVICE_URL)
CRICLIVE_DATA_PROVIDER=mock
CRICKET_DATA_PROVIDER=mock

# Server-Side Provider Credentials & Endpoints (SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_)
# Required if CRICLIVE_DATA_PROVIDER=partner_api
CRICLIVE_PARTNER_API_KEY=""
CRICLIVE_PARTNER_BASE_URL="https://api.cricket-data-partner.com/v1"

# External Scraper Microservice Endpoint
# Required if CRICLIVE_DATA_PROVIDER=scraper_bridge
CRICLIVE_SCRAPER_SERVICE_URL="http://localhost:5000"

# Upstream Provider Timeouts (Milliseconds)
CRICLIVE_HTTP_TIMEOUT_MS=5000

# Cache TTL Configurations (Seconds)
# Live match score updates (15s recommended to prevent stale live scores)
CRICLIVE_CACHE_LIVE_TTL_SECONDS=15
# Static tournament schedules, completed results, and rankings (3600s / 1 hour)
CRICLIVE_CACHE_STATIC_TTL_SECONDS=3600
